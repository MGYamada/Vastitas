abstract type Numeric;
subtype Nat <: Numeric;
subtype Int <: Numeric;

fn widen(x) domain();
fn widen(x: Numeric) -> Int domain((Numeric));
fn widen(x: Nat) -> Int { int(x) }
fn widen(x: Int) -> Int { x }

fn main() -> Int {
    let n: Nat = 20;
    let total = show!(widen(n) + widen(22));
    0
}
