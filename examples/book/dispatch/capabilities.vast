// ANCHOR: program
fn below_ten(x) domain((Nat), (Int), (Bool));

// The fallback applies at every key.
fn below_ten(x: Any) -> Bool { false }
// This method applies at (Nat) and at (Int), where `<` exists.
// ANCHOR: requires
fn below_ten(x: Any) -> Bool requires (HasOrder) { x < 10 }
// ANCHOR_END: requires

fn main() -> Int {
    let n: Nat = 7;
    let natural = show!(below_ten(n));
    let integer = show!(below_ten(-7));
    let boolean = show!(below_ten(true));
    if natural && integer && !boolean { 0 } else { 1 }
}
// ANCHOR_END: program
