mod profile;

// Presented QQ-algebras as canonical affine objects (historical Stage 2).
// Each declaration is one object; its base chain is declared, not inferred.
use profile::AffineQQ;
use profile::Over;
use profile::SpecQQ;
use profile::compose;
use profile::same;

indexed affine D(AffineQQ) = spec[e] relations(e^2) over SpecQQ;
indexed affine Line(AffineQQ) = spec[t] over SpecQQ;
indexed affine S(AffineQQ) = spec[t] over SpecQQ;
indexed affine X(AffineQQ) = spec[t, x] relations(x^2 - t) over S by(t -> t);
indexed affine Origin(AffineQQ) = spec[] over S by(t -> 0);
indexed affine DS(AffineQQ) = spec[e] relations(e^2) over S by(t -> 0);

// D-valued points of the line: t |-> e and t |-> 0, and the closed point of D.
indexed morphism p: Over<D, Line, SpecQQ> = pullback(t -> e);
indexed morphism q: Over<D, Line, SpecQQ> = pullback(t -> 0);
indexed morphism closed: Over<SpecQQ, D, SpecQQ> = pullback(e -> 0);
// Pullbacks compose in the written order: compose(after, before).
indexed morphism sq: Over<Line, Line, SpecQQ> = pullback(t -> t^2);
indexed morphism shift: Over<Line, Line, SpecQQ> = pullback(t -> t + 1);
// A DS-valued point of the family X over S, and both structure maps.
indexed morphism toX: Over<DS, X, S> = pullback(t -> 0, x -> e);
indexed morphism toS: Over<X, S, S> = structure;
indexed morphism dsToS: Over<DS, S, S> = structure;

indexed primitive eps = relative_coefficient(Over, D, Line, t, e);
indexed primitive slope = relative_coefficient(Over, Line, Line, t, t);
// A rational point of the line from runtime integers, and its coordinate.
indexed primitive at = relative_int_point(Over, Line, SpecQQ);
indexed primitive value = relative_coefficient(Over, SpecQQ, Line, t, 1);

fn verdict(ok: Bool, code: Int) -> Int { if ok { 0 } else { code } }

fn main() -> Int {
    // Same underlying point, different first-order data: e is preserved.
    42 + verdict(!same(p(), q()), 1)
       + verdict(same(compose(p(), closed()), compose(q(), closed())), 2)
       + verdict(pair_first(eps(p())) == 1, 3)
       // (t + 1)^2 versus t^2 + 1.
       + verdict(pair_first(slope(compose(sq(), shift()))) == 2, 4)
       + verdict(pair_first(slope(compose(shift(), sq()))) == 0, 5)
       // The triangle over S commutes.
       + verdict(same(compose(toS(), toX()), dsToS()), 6)
       // Pulling t back along sq at the point 3 gives 9.
       + verdict(pair_first(value(compose(sq(), at(3)))) == 9, 7)
}
