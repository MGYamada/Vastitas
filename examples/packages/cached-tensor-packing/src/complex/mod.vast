// T[i,k,j] B[k,l] -> C[i,j,l], with checked reuse of one caller-owned packing.
pub resource fn product() -> Unit {
    space u = linear(super::profiles::ComplexSmooth, 2); basis bu = basis(u);
    space v = linear(super::profiles::ComplexSmooth, 3); basis bv = basis(v);
    space w = linear(super::profiles::ComplexSmooth, 2); basis bw = basis(w);
    space x = linear(super::profiles::ComplexSmooth, 2); basis bx = basis(x);
    space vd = dual(v); basis bvd = derived(bv, vd);
    space xd = dual(x); basis bxd = derived(bx, xd);
    allocate original: Complex<F64>[20]; allocate right: Complex<F64>[10];
    allocate scratch: Complex<F64>[17]; allocate result: Complex<F64>[12];
    borrow init_t = write(original, layout(16, 2, 6, 3, false));
    store(init_t, 0, 0, complex_bits(0, 4607182418800017408));
    store(init_t, 1, 0, complex_bits(0, 4611686018427387904));
    store(init_t, 0, 1, complex_bits(0, 4613937818241073152));
    store(init_t, 1, 1, complex_bits(0, 4616189618054758400));
    store(init_t, 0, 2, complex_bits(0, 4617315517961601024));
    store(init_t, 1, 2, complex_bits(0, 4618441417868443648));
    store(init_t, 0, 3, complex_bits(0, 4619567317775286272));
    store(init_t, 1, 3, complex_bits(0, 4620693217682128896));
    store(init_t, 0, 4, complex_bits(0, 4621256167635550208));
    store(init_t, 1, 4, complex_bits(0, 4621819117588971520));
    store(init_t, 0, 5, complex_bits(0, 4622382067542392832));
    store(init_t, 1, 5, complex_bits(0, 4622945017495814144));
    release(init_t);
    borrow init_b = write(right, layout(16, 3, 2, 4, false));
    store(init_b, 0, 0, complex_bits(0, 4607182418800017408));
    store(init_b, 1, 0, complex_bits(0, 0));
    store(init_b, 2, 0, complex_bits(0, 4607182418800017408));
    store(init_b, 0, 1, complex_bits(0, 0));
    store(init_b, 1, 1, complex_bits(0, 4607182418800017408));
    store(init_b, 2, 1, complex_bits(0, 4607182418800017408));
    release(init_b);
    borrow input_t = read(original, layout(16, 2, 6, 3, false));
    borrow input_b = read(right, layout(16, 3, 2, 4, false));
    tensor t = view3(input_t, bu, bvd, bw, axes(0, 1, 2), 1);
    tensor b = view2(input_b, bv, bxd);
    borrow packing = write(scratch, layout(16, 4, 3, 5, false));
    tensor destination = view3(packing, bu, bvd, bw, axes(0, 2, 1), 2);
    cache saved = pack3(t, destination);
    release(input_t);
    release(packing);
    borrow packed_read = read(scratch, layout(16, 4, 3, 5, false));
    tensor packed = view3(packed_read, bu, bvd, bw, axes(0, 2, 1), 2);
    borrow output = write(result, layout(16, 4, 2, 5, false));
    tensor c = view3(output, bu, bw, bxd, axes(0, 1, 2), 2);
    contract3_cached(saved, packed, b, c, NativeFast);
    contract3_cached(saved, packed, b, c, NativeFast);
    release(output);
    borrow checked = read(result, layout(16, 4, 2, 5, false));
    expect(checked, 0, 0, complex_bits(13841813454723219456, 0));
    expect(checked, 1, 0, complex_bits(13844065254536904704, 0));
    expect(checked, 2, 0, complex_bits(13849131804117696512, 0));
    expect(checked, 3, 0, complex_bits(13849694754071117824, 0));
    expect(checked, 0, 1, complex_bits(13844065254536904704, 0));
    expect(checked, 1, 1, complex_bits(13845191154443747328, 0));
    expect(checked, 2, 1, complex_bits(13849694754071117824, 0));
    expect(checked, 3, 1, complex_bits(13850257704024539136, 0));
    release(checked); release(packed_read); release(input_b);
    drop(result); drop(scratch); drop(right); drop(original);
    value { () }
}
