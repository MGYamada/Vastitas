// T[i,k,j] B[k,l] -> C[i,j,l], with checked reuse of one caller-owned packing.
pub resource fn product() -> Unit {
    space u = linear(super::profiles::RealSmooth, 2); basis bu = basis(u);
    space v = linear(super::profiles::RealSmooth, 3); basis bv = basis(v);
    space w = linear(super::profiles::RealSmooth, 2); basis bw = basis(w);
    space x = linear(super::profiles::RealSmooth, 2); basis bx = basis(x);
    space vd = dual(v); basis bvd = derived(bv, vd);
    space xd = dual(x); basis bxd = derived(bx, xd);
    allocate original: F64[20]; allocate right: F64[10];
    allocate scratch: F64[17]; allocate result: F64[12];
    borrow init_t = write(original, layout(8, 2, 6, 3, false));
    store(init_t, 0, 0, f64_bits(4607182418800017408));
    store(init_t, 1, 0, f64_bits(4611686018427387904));
    store(init_t, 0, 1, f64_bits(4613937818241073152));
    store(init_t, 1, 1, f64_bits(4616189618054758400));
    store(init_t, 0, 2, f64_bits(4617315517961601024));
    store(init_t, 1, 2, f64_bits(4618441417868443648));
    store(init_t, 0, 3, f64_bits(4619567317775286272));
    store(init_t, 1, 3, f64_bits(4620693217682128896));
    store(init_t, 0, 4, f64_bits(4621256167635550208));
    store(init_t, 1, 4, f64_bits(4621819117588971520));
    store(init_t, 0, 5, f64_bits(4622382067542392832));
    store(init_t, 1, 5, f64_bits(4622945017495814144));
    release(init_t);
    borrow init_b = write(right, layout(8, 3, 2, 4, false));
    store(init_b, 0, 0, f64_bits(4607182418800017408));
    store(init_b, 1, 0, f64_bits(0));
    store(init_b, 2, 0, f64_bits(4607182418800017408));
    store(init_b, 0, 1, f64_bits(0));
    store(init_b, 1, 1, f64_bits(4607182418800017408));
    store(init_b, 2, 1, f64_bits(4607182418800017408));
    release(init_b);
    borrow input_t = read(original, layout(8, 2, 6, 3, false));
    borrow input_b = read(right, layout(8, 3, 2, 4, false));
    tensor t = view3(input_t, bu, bvd, bw, axes(0, 1, 2), 1);
    tensor b = view2(input_b, bv, bxd);
    borrow packing = write(scratch, layout(8, 4, 3, 5, false));
    tensor destination = view3(packing, bu, bvd, bw, axes(0, 2, 1), 2);
    cache saved = pack3(t, destination);
    release(input_t);
    release(packing);
    borrow packed_read = read(scratch, layout(8, 4, 3, 5, false));
    tensor packed = view3(packed_read, bu, bvd, bw, axes(0, 2, 1), 2);
    borrow output = write(result, layout(8, 4, 2, 5, false));
    tensor c = view3(output, bu, bw, bxd, axes(0, 1, 2), 2);
    contract3_cached(saved, packed, b, c, NativeFast);
    contract3_cached(saved, packed, b, c, NativeFast);
    release(output);
    borrow checked = read(result, layout(8, 4, 2, 5, false));
    expect(checked, 0, 0, f64_bits(4618441417868443648));
    expect(checked, 1, 0, f64_bits(4620693217682128896));
    expect(checked, 2, 0, f64_bits(4625759767262920704));
    expect(checked, 3, 0, f64_bits(4626322717216342016));
    expect(checked, 0, 1, f64_bits(4620693217682128896));
    expect(checked, 1, 1, f64_bits(4621819117588971520));
    expect(checked, 2, 1, f64_bits(4626322717216342016));
    expect(checked, 3, 1, f64_bits(4626885667169763328));
    release(checked); release(packed_read); release(input_b);
    drop(result); drop(scratch); drop(right); drop(original);
    value { () }
}
