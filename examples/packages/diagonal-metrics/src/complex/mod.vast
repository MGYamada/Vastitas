pub resource fn exercise() -> Unit {
    space v = linear(super::profiles::ComplexSmooth, 2);
    space w = linear(super::profiles::ComplexSmooth, 3);
    basis bv = basis(v); basis bw = basis(w);
    involution sigma = canonical(v);
    metric hv = diagonal(bv, sigma, [2, -4]);
    metric hw = diagonal(bw, sigma, [3, 5, -2]);
    allocate a: Complex<F64>[9]; allocate out: Complex<F64>[10];
    borrow wa = write(a, layout(16,3,2,4,false));
    store(wa,0,0,complex_bits(4607182418800017408, 4607182418800017408));
    store(wa,1,0,complex_bits(4613937818241073152, 4613937818241073152));
    store(wa,2,0,complex_bits(4617315517961601024, 4617315517961601024));
    store(wa,0,1,complex_bits(4611686018427387904, 4611686018427387904));
    store(wa,1,1,complex_bits(4616189618054758400, 4616189618054758400));
    store(wa,2,1,complex_bits(4618441417868443648, 4618441417868443648));
    release(wa);
    borrow ra = read(a, layout(16,3,2,4,false));
    borrow wo = write(out, layout(16,2,3,3,false));
    map input = view(ra,bv,bw); map output = view(wo,bw,bv);
    adjoint_into(input,output,hv,hw,NativeFast);
    release(wo);
    borrow ro = read(out, layout(16,2,3,3,false));
    expect(ro,0,0,complex_bits(4609434218613702656, 13832806255468478464));
    expect(ro,1,0,complex_bits(13832806255468478464, 4609434218613702656));
    expect(ro,0,1,complex_bits(4620130267728707584, 13843502304583483392));
    expect(ro,1,1,complex_bits(13840687554816376832, 4617315517961601024));
    expect(ro,0,2,complex_bits(13840687554816376832, 4617315517961601024));
    expect(ro,1,2,complex_bits(4613937818241073152, 13837309855095848960));
    release(ro); release(ra); drop(a); drop(out);
    space vc = conjugate(v,sigma); basis bvc = derived(bv,vc);
    allocate x: Complex<F64>[3]; allocate y: Complex<F64>[3];
    allocate scratch_owner: Complex<F64>[3]; allocate scalar_result: Complex<F64>[2];
    borrow wx = write(x, layout(16,2,1,3,false));
    store(wx,0,0,complex_bits(4607182418800017408, 4607182418800017408)); store(wx,1,0,complex_bits(4611686018427387904, 13830554455654793216)); release(wx);
    borrow wy = write(y, layout(16,2,1,3,false));
    store(wy,0,0,complex_bits(4613937818241073152, 13835058055282163712)); store(wy,1,0,complex_bits(4607182418800017408, 4616189618054758400)); release(wy);
    borrow rx = read(x, layout(16,2,1,3,false));
    borrow ry = read(y, layout(16,2,1,3,false));
    vector vx = view(rx,bv); vector vy = view(ry,bv);
    vector xc = conjugate(vx,bvc,sigma);
    borrow result0 = write(scalar_result,layout(16,1,1,2,false));
    hermitian_diagonal(xc,vy,result0,hv,scratch(scratch_owner,layout(16,2,1,3,false)),overwrite,NativeFast);
    release(result0);
    borrow verify0 = read(scalar_result,layout(16,1,1,2,false));
    expect(verify0,0,0,complex_bits(4621819117588971520, 13855042778628620288)); release(verify0);
    borrow result1 = write(scalar_result,layout(16,1,1,2,false));
    hermitian_diagonal(xc,vy,result1,hv,scratch(scratch_owner,layout(16,2,1,3,false)),overwrite,NativeFast);
    release(result1);
    borrow verify1 = read(scalar_result,layout(16,1,1,2,false));
    expect(verify1,0,0,complex_bits(4621819117588971520, 13855042778628620288)); release(verify1);
    release(xc); release(rx); release(ry);
    drop(x); drop(y); drop(scratch_owner); drop(scalar_result);
    value { () }
}
