pub resource fn exercise() -> Unit {
    space v = linear(super::profiles::RealSmooth, 2);
    space w = linear(super::profiles::RealSmooth, 3);
    basis bv = basis(v); basis bw = basis(w);
    involution sigma = canonical(v);
    metric hv = diagonal(bv, sigma, [2, -4]);
    metric hw = diagonal(bw, sigma, [3, 5, -2]);
    allocate a: F64[9]; allocate out: F64[10];
    borrow wa = write(a, layout(8,3,2,4,false));
    store(wa,0,0,f64_bits(4607182418800017408));
    store(wa,1,0,f64_bits(4613937818241073152));
    store(wa,2,0,f64_bits(4617315517961601024));
    store(wa,0,1,f64_bits(4611686018427387904));
    store(wa,1,1,f64_bits(4616189618054758400));
    store(wa,2,1,f64_bits(4618441417868443648));
    release(wa);
    borrow ra = read(a, layout(8,3,2,4,false));
    borrow wo = write(out, layout(8,2,3,3,false));
    map input = view(ra,bv,bw); map output = view(wo,bw,bv);
    adjoint_into(input,output,hv,hw,NativeFast);
    release(wo);
    borrow ro = read(out, layout(8,2,3,3,false));
    expect(ro,0,0,f64_bits(4609434218613702656));
    expect(ro,1,0,f64_bits(13832806255468478464));
    expect(ro,0,1,f64_bits(4620130267728707584));
    expect(ro,1,1,f64_bits(13840687554816376832));
    expect(ro,0,2,f64_bits(13840687554816376832));
    expect(ro,1,2,f64_bits(4613937818241073152));
    release(ro); release(ra); drop(a); drop(out);
    space vc = conjugate(v,sigma); basis bvc = derived(bv,vc);
    allocate x: F64[3]; allocate y: F64[3];
    allocate scratch_owner: F64[3]; allocate scalar_result: F64[2];
    borrow wx = write(x, layout(8,2,1,3,false));
    store(wx,0,0,f64_bits(4607182418800017408)); store(wx,1,0,f64_bits(4611686018427387904)); release(wx);
    borrow wy = write(y, layout(8,2,1,3,false));
    store(wy,0,0,f64_bits(4613937818241073152)); store(wy,1,0,f64_bits(4607182418800017408)); release(wy);
    borrow rx = read(x, layout(8,2,1,3,false));
    borrow ry = read(y, layout(8,2,1,3,false));
    vector vx = view(rx,bv); vector vy = view(ry,bv);
    vector xc = conjugate(vx,bvc,sigma);
    borrow result0 = write(scalar_result,layout(8,1,1,2,false));
    hermitian_diagonal(xc,vy,result0,hv,scratch(scratch_owner,layout(8,2,1,3,false)),overwrite,NativeFast);
    release(result0);
    borrow verify0 = read(scalar_result,layout(8,1,1,2,false));
    expect(verify0,0,0,f64_bits(13835058055282163712)); release(verify0);
    borrow result1 = write(scalar_result,layout(8,1,1,2,false));
    hermitian_diagonal(xc,vy,result1,hv,scratch(scratch_owner,layout(8,2,1,3,false)),overwrite,NativeFast);
    release(result1);
    borrow verify1 = read(scalar_result,layout(8,1,1,2,false));
    expect(verify1,0,0,f64_bits(13835058055282163712)); release(verify1);
    release(xc); release(rx); release(ry);
    drop(x); drop(y); drop(scratch_owner); drop(scalar_result);
    value { () }
}
