pub resource fn product() -> Unit {
    space u = linear(super::profiles::ComplexSmooth, 2);
    space v = linear(super::profiles::ComplexSmooth, 3);
    space w = linear(super::profiles::ComplexSmooth, 2);
    basis bu = basis(u);
    basis bv = basis(v);
    basis bw = basis(w);
    allocate a: Complex<F64>[6];
    allocate b: Complex<F64>[6];
    allocate c: Complex<F64>[4];
    borrow init_a = write(a, layout(0, 2, 3, 2, false));
    store(init_a, 0, 0, complex_bits(4607182418800017408, 0));
    store(init_a, 0, 1, complex_bits(0, 4607182418800017408));
    store(init_a, 0, 2, complex_bits(4611686018427387904, 0));
    store(init_a, 1, 0, complex_bits(0, 0));
    store(init_a, 1, 1, complex_bits(4607182418800017408, 0));
    store(init_a, 1, 2, complex_bits(9223372036854775808, 13830554455654793216));
    release(init_a);
    borrow init_b = write(b, layout(0, 3, 2, 3, false));
    store(init_b, 0, 0, complex_bits(4607182418800017408, 0));
    store(init_b, 0, 1, complex_bits(0, 0));
    store(init_b, 1, 0, complex_bits(4611686018427387904, 0));
    store(init_b, 1, 1, complex_bits(4607182418800017408, 0));
    store(init_b, 2, 0, complex_bits(0, 0));
    store(init_b, 2, 1, complex_bits(0, 4607182418800017408));
    release(init_b);
    borrow input_a = read(a, layout(0, 2, 3, 2, false));
    borrow input_b = read(b, layout(0, 3, 2, 3, false));
    borrow output = write(c, layout(0, 2, 2, 2, false));
    map left = view(input_a, bv, bw);
    map right = view(input_b, bu, bv);
    map destination = view(output, bu, bw);
    gemm(left, right, destination, overwrite, NativeFast);
    release(output);
    borrow updated = read_write(c, layout(0, 2, 2, 2, false));
    expect(updated, 0, 0, complex_bits(4607182418800017408, 4611686018427387904));
    expect(updated, 0, 1, complex_bits(0, 4613937818241073152));
    expect(updated, 1, 0, complex_bits(4611686018427387904, 0));
    expect(updated, 1, 1, complex_bits(4611686018427387904, 0));
    map accumulated = view(updated, bu, bw);
    gemm(left, right, accumulated, accumulate, NativeFast);
    expect(updated, 0, 0, complex_bits(4611686018427387904, 4616189618054758400));
    expect(updated, 0, 1, complex_bits(0, 4618441417868443648));
    expect(updated, 1, 0, complex_bits(4616189618054758400, 0));
    expect(updated, 1, 1, complex_bits(4616189618054758400, 0));
    release(updated);
    release(input_b);
    release(input_a);
    drop(c);
    drop(b);
    drop(a);
    value { () }
}
