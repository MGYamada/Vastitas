mod profiles;

// One immutable input allocation is reused with separate mathematical roles.
// No conjugation, dual identification or metric is inferred from its shape.
resource fn main() -> Int {
    space v = linear(profiles::ComplexSmooth, 1);
    basis bv = basis(v);
    space vd = dual(v);
    basis bvd = derived(bv, vd);
    involution sigma = canonical(v);
    space vc = conjugate(v, sigma);
    basis bvc = derived(bv, vc);
    metric h = orthonormal(bv, sigma);
    allocate input: Complex<F64>[4];
    allocate output: Complex<F64>[4];
    borrow init = write(input, layout(16, 1, 1, 3, false));
    fill(init, complex_bits(0, 4607182418800017408));
    release(init);
    borrow read_input = read(input, layout(16, 1, 1, 3, false));
    vector x = view(read_input, bv);
    vector phi = view(read_input, bvd);
    borrow out = write(output, layout(16, 1, 1, 3, false));
    call algebraic(v, bv, vd, bvd, phi, x, out) -> ();
    release(out);
    borrow checked_out = read_write(output, layout(16, 1, 1, 3, false));
    expect(checked_out, 0, 0, complex_bits(13830554455654793216, 0));
    call hermitian_value(v, bv, sigma, vc, bvc, h, x, x, checked_out) -> ();
    expect(checked_out, 0, 0, complex_bits(4607182418800017408, 0));
    release(checked_out);
    release(read_input);
    drop(input);
    drop(output);
    value { 42 }
}

resource fn algebraic(v: Space<profiles::ComplexSmooth, 1>, bv: Basis<v>,
    vd: DualSpace<v>, bvd: DerivedBasis<bv, vd>, phi: ReadVector<bvd>, x: ReadVector<bv>,
    output: Write<Complex<F64>, 1, 1> initializes) -> Unit {
    evaluate(phi, x, output, overwrite, NativeFast);
    value { () }
}

resource fn hermitian_value(v: Space<profiles::ComplexSmooth, 1>, bv: Basis<v>,
    sigma: Involution<v>, vc: ConjugateSpace<v, sigma>, bvc: DerivedBasis<bv, vc>, h: OrthonormalMetric<bv, sigma>,
    x: ReadVector<bv>, y: ReadVector<bv>, output: Write<Complex<F64>, 1, 1> initializes) -> Unit {
    vector conjugated = conjugate(x, bvc, sigma);
    call pairing_into(v, bv, sigma, vc, bvc, h, conjugated, y, output) -> ();
    release(conjugated);
    value { () }
}

resource fn pairing_into(v: Space<profiles::ComplexSmooth, 1>, bv: Basis<v>,
    sigma: Involution<v>, vc: ConjugateSpace<v, sigma>, bvc: DerivedBasis<bv, vc>, h: OrthonormalMetric<bv, sigma>,
    x: ReadVector<bvc>, y: ReadVector<bv>, output: Write<Complex<F64>, 1, 1> initializes) -> Unit {
    hermitian(x, y, output, h, overwrite, NativeFast);
    value { () }
}
