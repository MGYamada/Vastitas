mod profiles;
resource fn multiply(m: Nat, k: Nat, n: Nat, u: RuntimeSpace<profiles::RealSmooth, m>, v: RuntimeSpace<profiles::RealSmooth, k>, w: RuntimeSpace<profiles::RealSmooth, n>, bu: RuntimeBasis<u>, bv: RuntimeBasis<v>, bw: RuntimeBasis<w>, left: RuntimeMap<bv, bu, read>, right: RuntimeMap<bw, bv, read>, output: RuntimeMap<bw, bu, write> initializes) -> Unit {
    runtime_gemm(left, right, output, overwrite, NativeFast);
    value { () }
}
resource fn run(m: Nat, k: Nat, n: Nat, pad: Nat) -> Unit {
    let lda: Nat = value { m + pad };
    let ldb: Nat = value { k + pad };
    let ldc: Nat = value { m + pad };
    let cap_a: Nat = value { lda * k };
    let cap_b: Nat = value { ldb * n };
    let cap_c: Nat = value { ldc * n };
    runtime_space u = linear(profiles::RealSmooth, m);
    runtime_space v = linear(profiles::RealSmooth, k);
    runtime_space w = linear(profiles::RealSmooth, n);
    runtime_basis bu = basis(u); runtime_basis bv = basis(v); runtime_basis bw = basis(w);
    runtime_allocate data_a: F64[cap_a] runtime_layout(m, k, lda, false);
    runtime_allocate data_b: F64[cap_b] runtime_layout(k, n, ldb, false);
    runtime_allocate data_c: F64[cap_c] runtime_layout(m, n, ldc, false);
    runtime_borrow ia = write(data_a); runtime_fill(ia, f64_bits(4607182418800017408)); runtime_release(ia);
    runtime_borrow ib = write(data_b); runtime_fill(ib, f64_bits(4611686018427387904)); runtime_release(ib);
    runtime_borrow a = read(data_a); runtime_borrow b = read(data_b); runtime_borrow c = write(data_c);
    runtime_map left = view(a, bv, bu); runtime_map right = view(b, bw, bv); runtime_map output = view(c, bw, bu);
    call multiply(m, k, n, u, v, w, bu, bv, bw, left, right, output) -> ();
    call multiply(m, k, n, u, v, w, bu, bv, bw, left, right, output) -> ();
    runtime_release(c);
    runtime_borrow checked = read(data_c);
    runtime_expect(checked, 0, 0, f64_bits(4618441417868443648));
    runtime_release(checked); runtime_release(b); runtime_release(a);
    runtime_drop(data_a); runtime_drop(data_b); runtime_drop(data_c);
    value { () }
}
resource fn main() -> Int {
    let m: Nat = value { 2 }; let k: Nat = value { 3 };
    let n: Nat = value { 4 }; let pad: Nat = value { 0 };
    call run(m, k, n, pad) -> ();

    let other_m: Nat = value { 3 };
    let other_k: Nat = value { 3 };
    let other_n: Nat = value { 2 };
    let other_pad: Nat = value { 2 };
    call run(other_m, other_k, other_n, other_pad) -> ();
    value { 0 }
}
