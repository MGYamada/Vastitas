pub resource fn product() -> Unit {
    space u = linear(super::profiles::RealSmooth, 2); basis bu = basis(u);
    space v = linear(super::profiles::RealSmooth, 3); basis bv = basis(v);
    space w = linear(super::profiles::RealSmooth, 4); basis bw = basis(w);
    space a = linear(super::profiles::RealSmooth, 5); basis ba = basis(a);
    space b = linear(super::profiles::RealSmooth, 6); basis bb = basis(b);
    space vd = dual(v); basis bvd = derived(bv, vd);
    space wd = dual(w); basis bwd = derived(bw, wd);
    space ad = dual(a); basis bad = derived(ba, ad);
    space bd = dual(b); basis bbd = derived(bb, bd);
    allocate original: F64[39];
    allocate matrix_a: F64[23];
    allocate matrix_b: F64[33];
    allocate scratch: F64[47];
    allocate middle: F64[48];
    allocate result: F64[69];
    borrow init_t = write(original, layout(8, 2, 12, 3, false));
    fill(init_t, f64_bits(4607182418800017408));
    store(init_t, 1, 1, f64_bits(4613937818241073152));
    release(init_t);
    borrow input_t = read(original, layout(8, 2, 12, 3, false));
    borrow init_a = write(matrix_a, layout(8, 3, 5, 4, false));
    fill(init_a, f64_bits(4607182418800017408));
    store(init_a, 0, 4, f64_bits(4611686018427387904));
    release(init_a);
    borrow input_a = read(matrix_a, layout(8, 3, 5, 4, false));
    borrow init_b = write(matrix_b, layout(8, 4, 6, 5, false));
    fill(init_b, f64_bits(4607182418800017408));
    store(init_b, 3, 0, f64_bits(13830554455654793216));
    release(init_b);
    borrow input_b = read(matrix_b, layout(8, 4, 6, 5, false));
    borrow output = write(result, layout(8, 10, 6, 11, false));
    tensor t = view3(input_t, bu, bvd, bwd, axes(0,1,2), 1);
    tensor right_a = view2(input_a, bv, bad);
    tensor right_b = view2(input_b, bw, bbd);
    tensor c = view3(output, bu, bad, bbd, axes(0,1,2), 2);
    contract_tree(c, NativeFast) {
        occurrence t = t; occurrence a = right_a; occurrence b = right_b;
        edge ev = (t[1], a[0]); edge ew = (t[2], b[0]);
        boundary(t[0], a[1], b[1]);
        plan {
            borrow packed_write = write(scratch, layout(8, 8, 3, 9, false));
            tensor first_pack = view3(packed_write, bu, bvd, bwd, axes(0,2,1), 2);
            regroup(t, first_pack); release(packed_write);
            borrow packed_read = read(scratch, layout(8, 8, 3, 9, false));
            tensor first_read = view3(packed_read, bu, bvd, bwd, axes(0,2,1), 2);
            rebind(t, first_read);
            borrow middle_write = write(middle, layout(8, 8, 5, 9, false));
            tensor intermediate = view3(middle_write, bu, bwd, bad, axes(0,1,2), 2);
            join ta = (ev, t, a, intermediate);
            release(middle_write); release(packed_read);
            borrow middle_read = read(middle, layout(8, 8, 5, 9, false));
            tensor intermediate_read = view3(middle_read, bu, bwd, bad, axes(0,1,2), 2);
            rebind(ta, intermediate_read);
            borrow repacked_write = write(scratch, layout(8, 10, 4, 11, false));
            tensor second_pack = view3(repacked_write, bu, bwd, bad, axes(0,2,1), 2);
            regroup(ta, second_pack); release(repacked_write); release(middle_read);
            borrow repacked_read = read(scratch, layout(8, 10, 4, 11, false));
            tensor second_read = view3(repacked_read, bu, bwd, bad, axes(0,2,1), 2);
            rebind(ta, second_read);
            join done = (ew, ta, b, c);
            release(repacked_read);
        }
    }
    release(output);
    borrow checked = read(result, layout(8, 10, 6, 11, false));
    expect(checked, 0, 0, f64_bits(4618441417868443648));
    expect(checked, 1, 0, f64_bits(4620693217682128896));
    expect(checked, 2, 0, f64_bits(4618441417868443648));
    expect(checked, 3, 0, f64_bits(4620693217682128896));
    expect(checked, 4, 0, f64_bits(4618441417868443648));
    expect(checked, 5, 0, f64_bits(4620693217682128896));
    expect(checked, 6, 0, f64_bits(4618441417868443648));
    expect(checked, 7, 0, f64_bits(4620693217682128896));
    expect(checked, 8, 0, f64_bits(4620693217682128896));
    expect(checked, 9, 0, f64_bits(4621819117588971520));
    expect(checked, 0, 1, f64_bits(4622945017495814144));
    expect(checked, 1, 1, f64_bits(4624070917402656768));
    expect(checked, 2, 1, f64_bits(4622945017495814144));
    expect(checked, 3, 1, f64_bits(4624070917402656768));
    expect(checked, 4, 1, f64_bits(4622945017495814144));
    expect(checked, 5, 1, f64_bits(4624070917402656768));
    expect(checked, 6, 1, f64_bits(4622945017495814144));
    expect(checked, 7, 1, f64_bits(4624070917402656768));
    expect(checked, 8, 1, f64_bits(4625196817309499392));
    expect(checked, 9, 1, f64_bits(4625759767262920704));
    expect(checked, 0, 2, f64_bits(4622945017495814144));
    expect(checked, 1, 2, f64_bits(4624070917402656768));
    expect(checked, 2, 2, f64_bits(4622945017495814144));
    expect(checked, 3, 2, f64_bits(4624070917402656768));
    expect(checked, 4, 2, f64_bits(4622945017495814144));
    expect(checked, 5, 2, f64_bits(4624070917402656768));
    expect(checked, 6, 2, f64_bits(4622945017495814144));
    expect(checked, 7, 2, f64_bits(4624070917402656768));
    expect(checked, 8, 2, f64_bits(4625196817309499392));
    expect(checked, 9, 2, f64_bits(4625759767262920704));
    expect(checked, 0, 3, f64_bits(4622945017495814144));
    expect(checked, 1, 3, f64_bits(4624070917402656768));
    expect(checked, 2, 3, f64_bits(4622945017495814144));
    expect(checked, 3, 3, f64_bits(4624070917402656768));
    expect(checked, 4, 3, f64_bits(4622945017495814144));
    expect(checked, 5, 3, f64_bits(4624070917402656768));
    expect(checked, 6, 3, f64_bits(4622945017495814144));
    expect(checked, 7, 3, f64_bits(4624070917402656768));
    expect(checked, 8, 3, f64_bits(4625196817309499392));
    expect(checked, 9, 3, f64_bits(4625759767262920704));
    expect(checked, 0, 4, f64_bits(4622945017495814144));
    expect(checked, 1, 4, f64_bits(4624070917402656768));
    expect(checked, 2, 4, f64_bits(4622945017495814144));
    expect(checked, 3, 4, f64_bits(4624070917402656768));
    expect(checked, 4, 4, f64_bits(4622945017495814144));
    expect(checked, 5, 4, f64_bits(4624070917402656768));
    expect(checked, 6, 4, f64_bits(4622945017495814144));
    expect(checked, 7, 4, f64_bits(4624070917402656768));
    expect(checked, 8, 4, f64_bits(4625196817309499392));
    expect(checked, 9, 4, f64_bits(4625759767262920704));
    expect(checked, 0, 5, f64_bits(4622945017495814144));
    expect(checked, 1, 5, f64_bits(4624070917402656768));
    expect(checked, 2, 5, f64_bits(4622945017495814144));
    expect(checked, 3, 5, f64_bits(4624070917402656768));
    expect(checked, 4, 5, f64_bits(4622945017495814144));
    expect(checked, 5, 5, f64_bits(4624070917402656768));
    expect(checked, 6, 5, f64_bits(4622945017495814144));
    expect(checked, 7, 5, f64_bits(4624070917402656768));
    expect(checked, 8, 5, f64_bits(4625196817309499392));
    expect(checked, 9, 5, f64_bits(4625759767262920704));
    release(checked); release(input_b); release(input_a); release(input_t);
    drop(result); drop(middle); drop(scratch); drop(matrix_b); drop(matrix_a); drop(original);
    value { () }
}
