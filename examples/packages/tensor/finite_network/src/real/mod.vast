pub resource fn product() -> Unit {
    space u = linear(super::profiles::RealSmooth, 2);
    space v = linear(super::profiles::RealSmooth, 3);
    space w = linear(super::profiles::RealSmooth, 2);
    basis bu = basis(u);
    basis bv = basis(v);
    basis bw = basis(w);
    allocate a: F64[6];
    allocate b: F64[6];
    allocate c: F64[4];
    borrow init_a = write(a, layout(0, 2, 3, 2, false));
    store(init_a, 0, 0, f64_bits(4607182418800017408));
    store(init_a, 0, 1, f64_bits(4611686018427387904));
    store(init_a, 0, 2, f64_bits(4613937818241073152));
    store(init_a, 1, 0, f64_bits(4616189618054758400));
    store(init_a, 1, 1, f64_bits(4617315517961601024));
    store(init_a, 1, 2, f64_bits(4618441417868443648));
    release(init_a);
    borrow init_b = write(b, layout(0, 3, 2, 3, false));
    store(init_b, 0, 0, f64_bits(4619567317775286272));
    store(init_b, 0, 1, f64_bits(4620693217682128896));
    store(init_b, 1, 0, f64_bits(4621256167635550208));
    store(init_b, 1, 1, f64_bits(4621819117588971520));
    store(init_b, 2, 0, f64_bits(4622382067542392832));
    store(init_b, 2, 1, f64_bits(4622945017495814144));
    release(init_b);
    borrow input_a = read(a, layout(0, 2, 3, 2, false));
    borrow input_b = read(b, layout(0, 3, 2, 3, false));
    borrow output = write(c, layout(0, 2, 2, 2, false));
    map left = view(input_a, bv, bw);
    map right = view(input_b, bu, bv);
    map destination = view(output, bu, bw);
    contract(destination, NativeFast) {
        occurrence a = left;
        occurrence b = right;
        edge(a.input, b.output);
        input(b.input);
        output(a.output);
    }
    release(output);
    borrow updated = read_write(c, layout(0, 2, 2, 2, false));
    expect(updated, 0, 0, f64_bits(4633359591634108416));
    expect(updated, 0, 1, f64_bits(4634204016564240384));
    expect(updated, 1, 0, f64_bits(4639094644284588032));
    expect(updated, 1, 1, f64_bits(4639622409865920512));
    release(updated);
    release(input_b);
    release(input_a);
    drop(c);
    drop(b);
    drop(a);
    value { () }
}
