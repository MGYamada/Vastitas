abstract type Numeric;
subtype Nat <: Numeric;
subtype Int <: Numeric;

fn widen(x) domain();
fn widen(x: Numeric) -> Int domain((Numeric));
// At the key (Nat) this method wins, and its result type is not `Int`.
fn widen(x: Nat) -> Nat { x }
fn widen(x: Int) -> Int { x }

fn main() -> Int {
    widen(42)
}
