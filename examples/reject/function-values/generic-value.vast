fn add(x, y) domain((Int, Int));

fn add(x: Int, y: Int) -> Int { x + y }

fn fold(f: Fn<(Int, Int), Bool>, x: Int, y: Int) -> Bool { f(x, y) }

fn main() -> Int {
    // The (Int, Int) method returns Int; the expected Bool cannot select a different method.
    if fold(self::add, 40, 2) { 0 } else { 1 }
}
