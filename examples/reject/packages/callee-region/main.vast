resource fn peek(input: Read<F64, 2, 2>) -> Unit {
    // The offset of a layout counts bytes of the allocation.
    borrow corner = read(input, layout(0, 1, 1, 1, false));
    release(corner);
    value { () }
}

resource fn main() -> Int {
    allocate data: F64[12];
    borrow output = write(data, layout(0, 3, 4, 3, false));
    fill(output, f64(1));
    release(output);
    // This view begins at byte 8, so byte 0 lies outside it.
    borrow input = read(data, layout(8, 2, 2, 3, false));
    call peek(input) -> ();
    release(input);
    drop(data);
    value { 42 }
}
