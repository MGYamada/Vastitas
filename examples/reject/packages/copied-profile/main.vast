mod first {
    pub indexed marker QQ;
    pub indexed implementation Grid(QQ, affine_descriptor) capabilities(dimension);
    pub indexed primitive grid = descriptor(Grid);
    pub indexed primitive size = dimension((Grid, QQ));
}

// The same text in another module declares another marker, another
// implementation and other primitives.
mod second {
    pub indexed marker QQ;
    pub indexed implementation Grid(QQ, affine_descriptor) capabilities(dimension);
    pub indexed primitive grid = descriptor(Grid);
    pub indexed primitive size = dimension((Grid, QQ));
}

fn main() -> Int {
    let X = first::grid(42);
    int(second::size(X))
}
