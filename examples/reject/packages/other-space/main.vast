mod profiles {
    pub indexed marker RealCoefficients;
    pub indexed implementation RealScalar(RealCoefficients, scalar_base(scheme, real)) capabilities();
    pub indexed global RealBase(RealScalar);
    pub indexed implementation RealLinear(RealCoefficients, linear_descriptor(RealBase, real)) capabilities();
}

resource fn main() -> Int {
    space u = linear(profiles::RealLinear, 2);
    space v = linear(profiles::RealLinear, 3);
    // `other` has the implementation and the dimension of `v`, but it is
    // another space.
    space other = linear(profiles::RealLinear, 3);
    basis bu = basis(u);
    basis bv = basis(v);
    basis bother = basis(other);
    allocate a: F64[6];
    allocate b: F64[6];
    allocate c: F64[4];
    borrow init_a = write(a, layout(0, 2, 3, 2, false));
    fill(init_a, f64(1));
    release(init_a);
    borrow init_b = write(b, layout(0, 3, 2, 3, false));
    fill(init_b, f64(2));
    release(init_b);
    borrow input_a = read(a, layout(0, 2, 3, 2, false));
    borrow input_b = read(b, layout(0, 3, 2, 3, false));
    borrow output = write(c, layout(0, 2, 2, 2, false));
    map left = view(input_a, bv, bu);
    map right = view(input_b, bu, bother);
    map destination = view(output, bu, bu);
    gemm(left, right, destination, overwrite, NativeFast);
    release(output);
    release(input_b);
    release(input_a);
    drop(c);
    drop(b);
    drop(a);
    value { 0 }
}
