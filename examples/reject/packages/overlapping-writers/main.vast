resource fn main() -> Int {
    allocate data: F64[4];
    borrow whole = write(data, layout(0, 2, 2, 2, false));
    // The first column lies in the view of `whole`, which is still live.
    borrow column = write(data, layout(0, 2, 1, 2, false));
    fill(column, f64(1));
    release(column);
    fill(whole, f64(2));
    release(whole);
    drop(data);
    value { 42 }
}
