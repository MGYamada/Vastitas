use std::geometry::smooth::affine::Pt;
use std::linalg::spectral::FreeModule;
use std::linalg::spectral::Endomorphism;
use std::linalg::spectral::Spectrum;
use std::linalg::spectral::Branch;

indexed free_module W: FreeModule<Pt> = basis(f1, f2);

// ANCHOR: declarations
// The Jordan block J = [[2, 1], [0, 2]] has chi = (t - 2)^2, whose root 2 is
// double, so chi' = 2(t - 2) is no unit modulo chi and J has no simple
// branch. Here W·chi' = (t - 2)^2 = chi, and W·chi' - 1 is not a multiple of
// chi.
indexed endomorphism J: Endomorphism<Pt> = rows((2, 1), (0, 2)) of W;
indexed spectrum SJ: Spectrum<Pt> = eigen(J, t);
indexed branch BJ: Branch<Pt> = simple(SJ, localize = 1, witness = frac(1, 2) * (t - 2), exponent = 1);
// ANCHOR_END: declarations

fn main() -> Int { 0 }
