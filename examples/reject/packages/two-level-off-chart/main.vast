use std::geometry::smooth::affine::SmoothR;
use std::linalg::spectral::FreeModule;
use std::linalg::spectral::Endomorphism;
use std::linalg::spectral::Spectrum;
use std::linalg::spectral::Branch;
use std::linalg::spectral::TransitionAverage;
use nature::dimension::Reading;
use nature::dimension::T;
use nature::model::Model;
use nature::errorbar::Calibration;
use nature::errorbar::Dataset;
use nature::errorbar::Comparison;

// The chart P of (delta, omega), the states g and e, and H, which the kernel
// checks to be symmetric.
indexed affine P(SmoothR) = Affine(2)[delta, omega];
indexed free_module V: FreeModule<P> = basis(g, e);
indexed endomorphism H: Endomorphism<P> =
    rows((frac(1, 2) * delta, frac(1, 2) * omega), (frac(1, 2) * omega, frac(-1, 2) * delta)) of V symmetric;
// chi = t^2 - (delta^2 + omega^2) / 4. On D(delta^2 + omega^2) the two
// eigenvalues +-sqrt(delta^2 + omega^2) / 2 are simple: the witness 2t gives
// 2t * chi' = 4t^2, which is delta^2 + omega^2 modulo chi.
indexed spectrum S: Spectrum<P> = eigen(H, t);
indexed branch B: Branch<P> = simple(S, localize = delta^2 + omega^2, witness = 2 * t, exponent = 1);
// The sum over the two eigenprojectors of P_k[e, g]^2, stated as a closed
// form that the kernel checks against the trace form of B on its chart.
indexed average A: TransitionAverage<P> = transition_average(B, from = g, to = e)
    = ratio(frac(1, 2) * omega^2, delta^2 + omega^2);
// Both coordinates are frequencies. The model names the field, the reading,
// the convention, the prepared and the observed state, the average that it
// predicts and the regime in which it holds, which no check proves.
indexed quantity Frequency = T^-1;
indexed reading r: Reading<P> = (delta: Frequency, omega: Frequency);
indexed convention c = hbar_one;
indexed model M: Model<P> = model(hamiltonian = H, reading = r, convention = c, prepare = g, observe = e,
    predicts = A, regime = assume("rotating-wave approximation, drive far below the transition frequency"));
// ANCHOR: declarations
// The laser is locked to resonance: the calibration gives delta = 0, and
// each point gives the Rabi frequency omega.
indexed calibration K: Calibration<P> = calibrate(delta = measured(0, u = frac(1, 100)), method = type_b,
    reference = "laser locked to the line center", revision = "2026-11-16");
// Without drive, at delta = omega = 0, the two eigenvalues meet: the point
// lies off the chart D(delta^2 + omega^2) of B, whatever the closed form
// says there.
indexed dataset D: Dataset<P> = measure(model = M, calibration = K, coverage = 2, points = [
    (omega = 2, value = measured(frac(1, 2), u = frac(1, 50))),
    (omega = 0, value = measured(0, u = frac(1, 50))),
]);
// ANCHOR_END: declarations

fn main() -> Int { 0 }
