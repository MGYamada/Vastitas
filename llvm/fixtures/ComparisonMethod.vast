fn before(x: Int, y: Int) -> Bool { y < x }

contribution ordered : before {
    fn before(x: Int, y: Int) requires (HasEq) -> Bool { x < y }
}
assemble before { apply ordered; }

fn main() -> Int {
    let left: Int = -340282366920938463463374607431768211457;
    let right: Int = -1;
    if before(left, right) { 42 } else { 7 }
}
