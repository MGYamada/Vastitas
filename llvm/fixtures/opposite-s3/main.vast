// The six permutations of three points; comp(g, f) applies f first.
use std::category::Category;
use std::category::Functor;
use std::category::compose;
indexed finite Obj { o; }
indexed finite Arr { p012; p021; p102; p120; p201; p210; }
indexed table sourceOf(Arr) -> Obj {
    (p012) => o;
    (p021) => o;
    (p102) => o;
    (p120) => o;
    (p201) => o;
    (p210) => o;
}
indexed table targetOf(Arr) -> Obj {
    (p012) => o;
    (p021) => o;
    (p102) => o;
    (p120) => o;
    (p201) => o;
    (p210) => o;
}
indexed table ids(Obj) -> Arr { (o) => p012; }
indexed table comp(Arr, Arr) -> Arr where composable(sourceOf, targetOf) {
    (p012, p012) => p012;
    (p012, p021) => p021;
    (p012, p102) => p102;
    (p012, p120) => p120;
    (p012, p201) => p201;
    (p012, p210) => p210;
    (p021, p012) => p021;
    (p021, p021) => p012;
    (p021, p102) => p201;
    (p021, p120) => p210;
    (p021, p201) => p102;
    (p021, p210) => p120;
    (p102, p012) => p102;
    (p102, p021) => p120;
    (p102, p102) => p012;
    (p102, p120) => p021;
    (p102, p201) => p210;
    (p102, p210) => p201;
    (p120, p012) => p120;
    (p120, p021) => p102;
    (p120, p102) => p210;
    (p120, p120) => p201;
    (p120, p201) => p012;
    (p120, p210) => p021;
    (p201, p012) => p201;
    (p201, p021) => p210;
    (p201, p102) => p021;
    (p201, p120) => p012;
    (p201, p201) => p120;
    (p201, p210) => p102;
    (p210, p012) => p210;
    (p210, p021) => p201;
    (p210, p102) => p120;
    (p210, p120) => p102;
    (p210, p201) => p021;
    (p210, p210) => p012;
}
indexed instance S3 : Category = finite_graph(Obj, Arr, sourceOf, targetOf, ids, comp);
indexed instance R : Category = Opposite<S3>;
indexed instance RR : Category = Opposite<R>;
indexed table onObjects(Obj) -> Obj { (o) => o; }
indexed table invert(Arr) -> Arr {
    (p012) => p012; (p021) => p021; (p102) => p102;
    (p120) => p201; (p201) => p120; (p210) => p210;
}
indexed instance Inversion : Functor = finite_functor(R, S3, onObjects, invert);

fn main() -> Int {
    let reversed = compose(R::p021, R::p102);
    let twice = compose(RR::p021, RR::p102);
    let mapped = finite::lookup::<Inversion::arrows>(Arr::p120);
    if reversed == R::p120 && twice == RR::p201 && mapped == Arr::p201 { 42 } else { 7 }
}
