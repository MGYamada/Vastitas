import Lean.Elab.Command
import Lean.Util.Path
import Lean.Compiler.ExternAttr
import Lean.Compiler.ImplementedByAttr

open Lean Elab Command System

/-! # Axiom and opacity audit of every kernel and oracle module

This file is a build check, not an assumed theorem. Build every kernel library
root, executable root, regression module and the oracle first (see
`docs/development/validation.md`), then run
`lake -d lean env lean -DwarningAsError=true scripts/audit_axioms.lean`.
The audit requires each `.olean` to exist; it does not check that it is current,
so a CI run from a clean checkout is the authoritative one.

Coverage does not depend on an import closure. The audit finds each project
package from its build directory on the Lean search path
(`<package>/.lake/build/lib/lean`) and enumerates every `.lean` source module of
that package. It skips `.lake`, hidden directories and nested Lake packages; the
optional native/numerical adapters are excluded from this audit. It imports
all of these modules. A source module outside the audited groups, or without a
built `.olean`, fails. Each executable root defines `main`, so each is imported in
an environment of its own.

Every declaration whose defining module is in an audited group, private or in any
namespace, may depend only on `propext`, `Classical.choice` and `Quot.sound`.
`sorry` elaborates to `sorryAx`, so it fails here as well as in the
`warningAsError` builds. Compiled code must also be the logical definition:
`extern`, `implemented_by`, `partial`, `unsafe` and `opaque` declarations fail
unless `exceptions` lists them with a reason, and every listed exception must
still exist. The only family exception is the `partial` functions generated by
`deriving Repr` (see `derivedRepr`). Proved `csimp` rewrites remain permitted. -/
namespace VastitasAxiomAudit

/-- Module groups of the kernel (`lean-kernel/`) and oracle (`lean/`) packages. -/
def groups : Array Name := #[`VastitasOracle, `VastitasKernel, `VastitasPromotion,
  `VastitasPublicTest, `VastitasStorageTest, `VastitasAlgebraTest, `Main]

/-- Lake executable roots. Each defines `main` and is audited in its own environment. -/
def executableRoots : Array Name :=
  #[`Main, `VastitasStorageTest.Emit, `VastitasStorageTest.NumericalEmit]

def approvedAxioms : Array Name := #[`propext, `Classical.choice, `Quot.sound]

structure Listed where
  module : Name
  /-- The declaration name with any private prefix removed. -/
  name : Name
  kind : String
  reason : String
  deriving Inhabited

def wireScanReason : String :=
  "wire pre-scan run by Main.process before Lean.Json.parse; it can only turn a request " ++
  "into E_PROTOCOL, grants no acceptance, and no certificate or oracle theorem refers to it"

/-- Documented runtime exceptions. None is part of a checker certificate, an oracle
theorem or generated code; each only reads or bounds the raw request. -/
def exceptions : Array Listed := #[
  { module := `Main, name := `readBounded, kind := "partial",
    reason := "stdin reader of the kernel process; it stops at end of input or past the byte " ++
      "bound, and every byte it returns is still scanned, decoded and checked" },
  { module := `VastitasKernel.WireScan, name := `VastitasKernel.WireScan.digitRun,
    kind := "partial", reason := wireScanReason },
  { module := `VastitasKernel.WireScan, name := `VastitasKernel.WireScan.value,
    kind := "partial", reason := wireScanReason },
  { module := `VastitasKernel.WireScan, name := `VastitasKernel.WireScan.array,
    kind := "partial", reason := wireScanReason },
  { module := `VastitasKernel.WireScan, name := `VastitasKernel.WireScan.object,
    kind := "partial", reason := wireScanReason }]

def derivedReprReason : String :=
  "Lean derives Repr on nested and mutual inductive types as partial functions; " ++
  "they only render diagnostics and debugging text and no checker or theorem consults them " ++
  "(the IndexedPromotion fixture's reprStr reification is a documented trusted build step)"

/-- A `partial` function generated by `deriving Repr`: it is named
`instRepr<Type>.repr` or `instRepr<Type>.repr_<n>` and returns `Std.Format`. -/
def derivedRepr (env : Environment) (name : Name) : Bool :=
  match privateToUserName name, env.find? name with
  | .str (.str _ owner) function, some info =>
    owner.startsWith "instRepr" && (function == "repr" || function.startsWith "repr_") &&
      info.type.getForallBody.isConstOf ``Std.Format
  | _, _ => false

def inGroup (module : Name) : Bool := groups.any (·.isPrefixOf module)

/-- `<package>` for every `<package>/.lake/build/lib/lean` search-path entry. -/
def packageRoots : IO (Array FilePath) := do
  let mut roots := #[]
  for entry in ← searchPathRef.get do
    let parts := entry.normalize.components
    if parts.length > 4 && parts.drop (parts.length - 4) == [".lake", "build", "lib", "lean"] then
      let root := FilePath.mk (FilePath.pathSeparator.toString.intercalate (parts.take (parts.length - 4)))
      unless roots.contains root do roots := roots.push root
  return roots

def isNestedPackage (directory : FilePath) : IO Bool := do
  return (← (directory / "lakefile.lean").pathExists) || (← (directory / "lakefile.toml").pathExists)

def sourceModules (root : FilePath) : IO (Array (Name × FilePath)) := do
  let files ← root.walkDir fun directory => do
    if directory == root then return true
    if (directory.fileName.getD "").startsWith "." then return false
    return !(← isNestedPackage directory)
  let mut modules := #[]
  for file in files do
    if file.extension == some "lean" && file.fileName != some "lakefile.lean" then
      modules := modules.push (← moduleNameOfFileName file (some root), file)
  return modules

/-- Constants that a kernel declaration refers to: its type, its value (also for
theorems and opaque constants) and the constructors of an inductive type. -/
def dependencies (info : ConstantInfo) : Array Name :=
  let used (expressions : List Expr) := expressions.foldl (fun found e => found ++ e.getUsedConstants) #[]
  match info with
  | .defnInfo v => used [v.type, v.value]
  | .thmInfo v => used [v.type, v.value]
  | .opaqueInfo v => used [v.type, v.value]
  | .inductInfo v => used [v.type] ++ v.ctors.toArray
  | info => used [info.type]

structure Reach where
  visited : NameSet := {}
  /-- The declaration through which a constant was first reached. -/
  parent : NameMap Name := {}
  axioms : Array Name := #[]

/-- Every axiom reachable from `roots`. One visited set per call and no cached
partial results, so the set is exact; `parent` explains each reached axiom. -/
def reach (env : Environment) (roots : Array Name) : Reach := Id.run do
  let mut state : Reach := {}
  for root in roots do
    if state.visited.contains root then continue
    state := { state with visited := state.visited.insert root }
    let mut stack := #[root]
    while !stack.isEmpty do
      let name := stack.back!
      stack := stack.pop
      let some info := env.find? name | continue
      if let .axiomInfo _ := info then state := { state with axioms := state.axioms.push name }
      for dependency in dependencies info do
        unless state.visited.contains dependency do
          state := { state with visited := state.visited.insert dependency,
                                parent := state.parent.insert dependency name }
          stack := stack.push dependency
  return state

/-- The audited root from which `reach` first reached `name`. -/
def origin (state : Reach) (name : Name) : Name := Id.run do
  let mut current := name
  for _ in [:state.visited.size + 1] do
    match state.parent.find? current with
    | some parent => current := parent
    | none => break
  return current

/-- Substitutions and logically opaque definitions, as (reported name, kind). A
`partial` definition is an opaque constant whose code is its `_unsafe_rec`
implementation; it is reported once, under its own name. Structural,
well-founded and `partial_fixpoint` definitions also compile from an
`_unsafe_rec` twin, but their constant is a transparent definition that the
twin's recursion equations are proved against, so they are not reported. -/
def opacity (env : Environment) (name : Name) (info : ConstantInfo) : Array (Name × String) := Id.run do
  let mut found := #[]
  let substituted := (getExternAttrData? env name).isSome || (Compiler.getImplementedBy? env name).isSome
  if (getExternAttrData? env name).isSome then found := found.push (name, "extern")
  if (Compiler.getImplementedBy? env name).isSome then found := found.push (name, "implemented_by")
  match name, info.isPartial with
  | .str base "_unsafe_rec", true =>
    if let some (.opaqueInfo _) := env.find? base then found := found.push (base, "partial")
  | _, _ =>
    if info.isPartial then found := found.push (name, "partial")
    if info.isUnsafe then found := found.push (name, "unsafe")
    if let .opaqueInfo _ := info then
      unless substituted || env.contains (name.str "_unsafe_rec") do
        found := found.push (name, "opaque")
  return found

def importClosure (env : Environment) (root : Name) : NameSet := Id.run do
  let header := env.header
  let mut seen : NameSet := {}
  let mut pending := #[root]
  while !pending.isEmpty do
    let module := pending.back!
    pending := pending.pop
    if seen.contains module then continue
    seen := seen.insert module
    if let some index := header.moduleNames.idxOf? module then
      if let some data := header.moduleData[index]? then
        pending := pending ++ data.imports.map (·.module)
  return seen

end VastitasAxiomAudit

open VastitasAxiomAudit in
run_cmd do
  let packages ← packageRoots
  if packages.isEmpty then
    throwError "no project package build directory (<package>/.lake/build/lib/lean) on the Lean search path"
  let mut sources : Array Name := #[]
  for package in packages do
    for (module, file) in ← sourceModules package do
      unless inGroup module do
        throwError "source module {module} ({file}) is outside the audited module groups {groups}"
      unless sources.contains module do sources := sources.push module
  for group in groups do
    unless sources.any (group.isPrefixOf ·) do
      throwError "required module group {group} has no source modules"
  for root in executableRoots do
    unless sources.contains root do throwError "executable root {root} has no source module"
  for module in sources do
    -- `findOLean` only locates the search root; it does not check the file.
    let built ← try (← findOLean module).pathExists catch _ => pure false
    unless built do
      throwError "source module {module} has no built .olean; build every kernel library, executable and the oracle before auditing"
  let libraries := sources.filter (!executableRoots.contains ·)
  let environments := #[libraries] ++ executableRoots.map (#[·])
  let mut audited : NameSet := {}
  let mut counts := groups.map fun _ => (0 : Nat)
  let mut privateCount : Nat := 0
  let mut used : Array Nat := #[]
  let mut libraryEnv? : Option Environment := none
  let mut unlisted : Array MessageData := #[]
  let mut derivedReprs : Nat := 0
  for modules in environments do
    let env ← importModules (modules.map ({ module := · })) {}
    if libraryEnv?.isNone then libraryEnv? := some env
    let mut roots : Array Name := #[]
    for (name, info) in env.constants.toList do
      let some index := env.getModuleIdxFor? name | continue
      let some owner := env.allImportedModuleNames[index.toNat]? |
        throwError "missing defining module for {name}"
      if audited.contains owner then continue
      let some group := groups.findIdx? (·.isPrefixOf owner) | continue
      for (reported, kind) in opacity env name info do
        match exceptions.findIdx? fun e =>
            e.module == owner && e.name == privateToUserName reported && e.kind == kind with
        | some exception => unless used.contains exception do used := used.push exception
        | none =>
          if kind == "partial" && derivedRepr env reported then derivedReprs := derivedReprs + 1
          else unlisted := unlisted.push m!"{kind} {reported} in {owner}"
      roots := roots.push name
      counts := counts.set! group (counts[group]! + 1)
      if isPrivateName name then privateCount := privateCount + 1
    let reached := reach env roots
    for axiomName in reached.axioms do
      unless approvedAxioms.contains axiomName do
        let declaration := origin reached axiomName
        let owner := (env.getModuleIdxFor? declaration).bind (env.allImportedModuleNames[·.toNat]?)
        throwError "unapproved axiom {axiomName} in {declaration} from {owner.getD .anonymous}"
    -- Modules holding only `#eval` regressions define no declarations; they are still imported.
    for module in env.allImportedModuleNames do
      if inGroup module then audited := audited.insert module
  unless unlisted.isEmpty do
    throwError "compiled code differs from the logical definition in unlisted declarations:{indentD (MessageData.joinSep unlisted.toList Format.line)}"
  for module in sources do
    unless audited.contains module do throwError "source module {module} was not audited"
  for index in [:groups.size] do
    unless counts[index]! > 0 do
      throwError "no declarations from required module group {groups[index]!}"
    logInfo m!"module group {groups[index]!}: {counts[index]!} declarations"
  for index in [:exceptions.size] do
    let exception := exceptions[index]!
    unless used.contains index do
      throwError "unused exception {exception.kind} {exception.name} in {exception.module}"
    logInfo m!"listed {exception.kind} {exception.name} in {exception.module}: {exception.reason}"
  logInfo m!"{derivedReprs} derived partial Repr functions: {derivedReprReason}"
  let some env := libraryEnv? | throwError "no library environment"
  let closure := importClosure env `VastitasOracle
  for module in sources do
    if Name.isPrefixOf `VastitasOracle module && !closure.contains module then
      throwError "oracle module {module} is not imported by the VastitasOracle root"
  logInfo m!"axiom audit passed for {counts.foldl (· + ·) 0} declarations ({privateCount} private) in {sources.size} modules"
  -- #350's least witness must come from accessibility search, not choice.
  for name in #[`VastitasOracle.LeastFuel.least, `VastitasOracle.LeastFuel.least_spec,
      `VastitasOracle.LeastFuel.least_minimal] do
    unless env.contains name do
      throwError "missing least-fuel search declaration {name}"
    for axiomName in (reach env #[name]).axioms do
      unless #[`propext, `Quot.sound].contains axiomName do
        throwError "choice or unapproved axiom {axiomName} in least-fuel search {name}"
  logInfo "least-fuel search uses no Classical.choice or custom axiom"
