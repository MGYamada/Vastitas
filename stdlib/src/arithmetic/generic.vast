// Finite scalar dispatch over the existing arithmetic functions.
// Include int.vast and nat.vast explicitly with --lib as well.

// Closed four-key promotion. These bodies own the only conversion policy.
fn promote(left, right) domain((Nat, Nat), (Nat, Int), (Int, Nat), (Int, Int));

fn promote(left: Nat, right: Nat) -> Pair<Nat> {
    pair(left, right)
}

fn promote(left: Nat, right: Int) -> Pair<Int> {
    pair(int(left), right)
}

fn promote(left: Int, right: Nat) -> Pair<Int> {
    pair(left, int(right))
}

fn promote(left: Int, right: Int) -> Pair<Int> {
    pair(left, right)
}

fn add(left, right) domain((Int, Int), (Nat, Nat), (Nat, Int), (Int, Nat));

fn add(left: Int, right: Int) -> Int {
    int_add(left, right)
}

fn add(left: Nat, right: Nat) -> Nat {
    nat_add(left, right)
}

fn add(left: Nat, right: Int) -> Int {
    let p = promote(left, right);
    self::add(pair_first(p), pair_second(p))
}

fn add(left: Int, right: Nat) -> Int {
    let p = promote(left, right);
    self::add(pair_first(p), pair_second(p))
}

fn maximum(left, right) domain((Int, Int), (Nat, Nat), (Nat, Int), (Int, Nat));

fn maximum(left: Int, right: Int) -> Int requires (HasOrder) {
    int_max(left, right)
}

fn maximum(left: Nat, right: Nat) -> Nat requires (HasOrder) {
    nat_max(left, right)
}

fn maximum(left: Nat, right: Int) -> Int requires (HasOrder) {
    let p = promote(left, right);
    maximum(pair_first(p), pair_second(p))
}

fn maximum(left: Int, right: Nat) -> Int requires (HasOrder) {
    let p = promote(left, right);
    maximum(pair_first(p), pair_second(p))
}
