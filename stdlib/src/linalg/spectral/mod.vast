// Exact spectral pairs and simple branches of polynomial matrix fields
// (historical Stage 5, ADR 0001 §12). Let A be the ring of the polynomials
// with exact rational coefficients in the coordinates of a smooth affine
// object X. FreeModule<X> indexes the free modules A^n on X with a named
// ordered basis, Endomorphism<X> the n x n matrices over A that act on one of
// them, Spectrum<X> the spectral pairs of those fields (the characteristic
// polynomial det(tI - H) with a named fiber coordinate t, and the module on
// which t acts as H), and Branch<X> the finite charts of a spectrum on which
// every eigenvalue is simple. This library declares the families only: the
// application declares its modules, fields, spectra, branches, invariants and
// observations, which name them, as it declares its frames and metrics.
pub indexed family FreeModule(object(geometry::smooth::affine::CInfAffine))
    = free_module constraints(canonical(0));
pub indexed family Endomorphism(object(geometry::smooth::affine::CInfAffine))
    = endomorphism constraints(canonical(0));
pub indexed family Spectrum(object(geometry::smooth::affine::CInfAffine))
    = spectrum constraints(canonical(0));
pub indexed family Branch(object(geometry::smooth::affine::CInfAffine))
    = branch constraints(canonical(0));
// TransitionAverage<X> (historical Stage 6, ADR 0001 §13) indexes the
// dephased transition averages of simple branches on X: the sum over the
// eigenprojectors P_k of a symmetric field of P_k[j, i]^2 between two basis
// vectors, stated by the application as a closed form N / D that the kernel
// checks against the trace form of the branch. The kernel does not check
// these declarations yet; the family is declared for the application.
pub indexed family TransitionAverage(object(geometry::smooth::affine::CInfAffine))
    = transition_average constraints(canonical(0));
