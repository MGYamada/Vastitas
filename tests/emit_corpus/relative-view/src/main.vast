mod profile;

// Presented QQ-algebras as canonical affine objects (historical Stage 2).
// Each declaration is one object; its base chain is declared, not inferred.
use profile::AffineQQ;
use profile::Over;
use profile::SpecQQ;
use profile::compose;
use profile::same;

indexed affine D(AffineQQ) = spec[e] relations(e^2) over SpecQQ;
indexed affine Line(AffineQQ) = spec[t] over SpecQQ;
indexed affine S(AffineQQ) = spec[t] over SpecQQ;
indexed affine X(AffineQQ) = spec[t, x] relations(x^2 - t) over S by(t -> t);
indexed affine Origin(AffineQQ) = spec[] over S by(t -> 0);
indexed affine DS(AffineQQ) = spec[e] relations(e^2) over S by(t -> 0);

// D-valued points of the line: t |-> e and t |-> 0, and the closed point of D.
indexed morphism p: Over<D, Line, SpecQQ> = pullback(t -> e);
indexed morphism q: Over<D, Line, SpecQQ> = pullback(t -> 0);
indexed morphism closed: Over<SpecQQ, D, SpecQQ> = pullback(e -> 0);
// Pullbacks compose in the written order: compose(after, before).
indexed morphism sq: Over<Line, Line, SpecQQ> = pullback(t -> t^2);
indexed morphism shift: Over<Line, Line, SpecQQ> = pullback(t -> t + 1);
// A DS-valued point of the family X over S, and both structure maps.
indexed morphism toX: Over<DS, X, S> = pullback(t -> 0, x -> e);
indexed morphism toS: Over<X, S, S> = structure;
indexed morphism dsToS: Over<DS, S, S> = structure;

// Base change: the fiber of X over the origin of S is Spec of the dual numbers.
indexed affine Fiber(AffineQQ) = fiber(X, Origin);
indexed morphism toOrigin: Over<DS, Origin, S> = pullback();
indexed morphism prX: Over<Fiber, X, S> = first;
indexed morphism back: Over<Fiber, DS, S> = pullback(e -> X::x);
indexed cartesian fiberIsDual = square(toX, toOrigin) through Fiber inverse back;
indexed primitive lift = relative_pair(Over, Fiber);
indexed primitive fiberX = relative_coefficient(Over, DS, Fiber, X::x, e);
// A separately declared copy of S is comparable only through a chosen isomorphism.
indexed affine S2(AffineQQ) = spec[t] over SpecQQ;
indexed affine Origin2(AffineQQ) = spec[] over S2 by(t -> 0);
indexed affine Fiber2(AffineQQ) = fiber(X, Origin2) via(t -> t) inverse(t -> t);

// Principal opens: D(t) and D(t^2) of the line, and the structure-sheaf action of sq.
indexed affine Dt(AffineQQ) = localize(Line, t) inverse u;
indexed affine Dt2(AffineQQ) = localize(Line, t^2) inverse v;
indexed morphism onOpens: Over<Dt2, Dt, SpecQQ> = restrict(sq);
indexed primitive inverseImage = relative_coefficient(Over, Dt2, Dt, u, v);
// The transition D(x) = D(y) of two affine lines by y = 1/x (#104).
indexed affine L1(AffineQQ) = spec[x] over SpecQQ;
indexed affine L2(AffineQQ) = spec[y] over SpecQQ;
indexed affine U1(AffineQQ) = localize(L1, x) inverse xi;
indexed affine U2(AffineQQ) = localize(L2, y) inverse yi;
indexed morphism glue: Over<U1, U2, SpecQQ> = pullback(y -> xi, yi -> x);
indexed morphism unglue: Over<U2, U1, SpecQQ> = pullback(x -> yi, xi -> y);
indexed iso transition = forward glue inverse unglue;
indexed affine Nothing(AffineQQ) = localize(Line, 0) inverse z;

indexed primitive eps = relative_coefficient(Over, D, Line, t, e);
indexed primitive slope = relative_coefficient(Over, Line, Line, t, t);
// A rational point of the line from runtime integers, and its coordinate.
indexed primitive at = relative_int_point(Over, Line, SpecQQ);
indexed primitive value = relative_coefficient(Over, SpecQQ, Line, t, 1);

// A morphism over S regarded over SpecQQ, a base on its chain (relative_view);
// no example package uses this primitive, so the emit corpus does.
indexed morphism overQQ: Over<X, X, SpecQQ> = identity;
indexed primitive view = relative_view(Over, S, SpecQQ);

fn verdict(ok: Bool, code: Int) -> Int { if ok { 0 } else { code } }

fn main() -> Int {
    // Same underlying point, different first-order data: e is preserved.
    42 + verdict(!same(p(), q()), 1)
       + verdict(same(compose(p(), closed()), compose(q(), closed())), 2)
       + verdict(pair_first(eps(p())) == 1, 3)
       // (t + 1)^2 versus t^2 + 1.
       + verdict(pair_first(slope(compose(sq(), shift()))) == 2, 4)
       + verdict(pair_first(slope(compose(shift(), sq()))) == 0, 5)
       // The triangle over S commutes.
       + verdict(same(compose(toS(), toX()), dsToS()), 6)
       // Pulling t back along sq at the point 3 gives 9.
       + verdict(pair_first(value(compose(sq(), at(3)))) == 9, 7)
       // The universal map into the fiber recovers both arrows.
       + verdict(same(compose(prX(), lift(toX(), toOrigin())), toX()), 8)
       + verdict(pair_first(fiberX(lift(toX(), toOrigin()))) == 1, 9)
       // On opens, u pulls back to v: 1/t pulls back to 1/t^2.
       + verdict(pair_first(inverseImage(onOpens())) == 1, 10)
       + verdict(same(compose(unglue(), glue()), compose(unglue(), glue())), 11)
       // Viewing toX over SpecQQ composes with the identity of X over SpecQQ.
       + verdict(same(view(toX()), compose(overQQ(), view(toX()))), 12)
}
