        "text": "[package]\nedition = \"2026\"\nname='base'\nversion='0.1.0'\nroot='main.vast'\n[dependencies]\n\n"
      },
      {
        "offset": 357,
        "path": "/authority-fixture/base/main.vast",
        "text": "\npub fn choose(x, y) domain((Int, Int), (Bool, Bool));\nfn choose(x: Any, y: Any) -> Int { 0 }\npub grant outer : choose to addon delegable { domain (Int, Int); }\npub transfer handoff : choose to addon;\npub contribution old : choose { fn choose(x: Int, y: Int) -> Int { 99 } }\n"
      },
      {
        "offset": 633,
        "path": "/authority-fixture/addon/main.vast",
        "text": "\npub delegation inner : base::choose to addon::ops { domain (Int, Int); }\npub contribution fresh : base::choose { fn base::choose(x: Bool, y: Bool) -> Int { 2 } }\npub mod ops {\n  pub contribution sum : base::choose { fn base::choose(x: Int, y: Int) -> Int { x + y } }\n}\n"
      },
      {
        "offset": 904,
        "path": "/authority-fixture/app/main.vast"
      }
    ],
    "offset": 904,
    "text": "assemble base::choose { borrow base::outer as parent { delegate addon::inner as child { apply addon::ops::sum; } } transfer base::handoff; apply addon::fresh; } fn main() -> Int { base::choose(40, 2) + base::choose(true, true) }"
