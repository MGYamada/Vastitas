end":2739,"line":58,"start":2730},"ty":{"kind":"named","name":"Int"}},{"name":"right","span":{"column":23,"end":2751,"line":58,"start":2741},"ty":{"kind":"named","name":"Nat"}}],"requires":["HasOrder"],"return_type":{"kind":"named","name":"Int"},"span":{"column":1,"end":2860,"line":58,"start":2719}}],"path":[],"public":true,"span":{"column":1,"end":0,"line":1,"start":0}}],"name":"legacy_flat","source":"vastitas:compat:flat","version":"1.0.0"}],"root":"vastitas:compat:flat","root_source":{"files":[{"offset":0,"path":"promotion-contract.vast"},{"offset":40,"path":"arithmetic/int.vast","text":"// Exact, arbitrary-precision integer arithmetic.\n// Primitive operators are checked and lowered by the Lean backend.\n\nfn int_add(left: Int, right: Int) -> Int {\n    left + right\n}\n\nfn int_sub(left: Int, right: Int) -> Int {\n    left - right\n}\n\nfn int_mul(left: Int, right: Int) -> Int {\n    left * right\n}\n\nfn int_neg(value: Int) -> Int {\n    -value\n}\n\nfn int_abs(value: Int) -> Int {\n    if value < 0 { -value } else { value }\n}\n\nfn int_min(left: Int, right: Int) -> Int {\n    if left <= right { left } else { right }\n}\n\nfn int_max(left: Int, right: Int) -> Int {\n    if left >= right { left } else { right }\n}\n"},{"offset":654,"path":"arithmetic/nat.vast","text":"// Exact, arbitrary-precision natural-number arithmetic.\n// Nat subtraction saturates at zero: nat_sub(2, 5) is 0.\n\nfn nat_add(left: Nat, right: Nat) -> Nat {\n    left + right\n}\n\nfn nat_sub(left: Nat, right: Nat) -> Nat {\n    left - right\n}\n\nfn nat_mul(left: Nat, right: Nat) -> Nat {\n    left * right\n}\n\nfn nat_min(left: Nat, right: Nat) -> Nat {\n    if left <= right { left } else { right }\n}\n\nfn nat_max(left: Nat, right: Nat) -> Nat {\n    if left >= right { left } else { right }\n}\n\n// Total explicit embedding; negative Int-to-Nat conversion is not provided.\nfn nat_to_int(value: Nat) -> Int { int(value) }\n"},{"offset":1267,"path":"arithmetic/generic.vast","text":"// Finite scalar dispatch over the existing arithmetic functions.\n// Include int.vast and nat.vast explicitly with --lib as well.\n\n// Closed four-key promotion. These bodies own the only conversion policy.\nfn promote(left, right) domain((Nat, Nat), (Nat, Int), (Int, Nat), (Int, Int));\n\nfn promote(left: Nat, right: Nat) -> Pair<Nat> {\n    pair(left, right)\n}\n\nfn promote(left: Nat, right: Int) -> Pair<Int> {\n    pair(int(left), right)\n}\n\nfn promote(left: Int, right: Nat) -> Pair<Int> {\n    pair(left, int(right))\n}\n\nfn promote(left: Int, right: Int) -> Pair<Int> {\n    pair(left, right)\n}\n\nfn add(left, right) domain((Int, Int), (Nat, Nat), (Nat, Int), (Int, Nat));\n\nfn add(left: Int, right: Int) -> Int {\n    int_add(left, right)\n}\n\nfn add(left: Nat, right: Nat) -> Nat {\n    nat_add(left, right)\n}\n\nfn add(left: Nat, right: Int) -> Int {\n    let p = promote(left, right);\n    self::add(pair_first(p), pair_second(p))\n}\n\nfn add(left: Int, right: Nat) -> Int {\n    let p = promote(left, right);\n    self::add(pair_first(p), pair_second(p))\n}\n\nfn maximum(left, right) domain((Int, Int), (Nat, Nat), (Nat, Int), (Int, Nat));\n\nfn maximum(left: Int, right: Int) -> Int requires (HasOrder) {\n    int_max(left, right)\n}\n\nfn maximum(left: Nat, right: Nat) -> Nat requires (HasOrder) {\n    nat_max(left, right)\n}\n\nfn maximum(left: Nat, right: Int) -> Int requires (HasOrder) {\n    let p = promote(left, right);\n    maximum(pair_first(p), pair_second(p))\n}\n\nfn maximum(left: Int, right: Nat) -> Int requires (HasOrder) {\n    let p = promote(left, right);\n    maximum(pair_first(p), pair_second(p))\n}\n"}],"offset":0,"text":"fn main() -> Int { self::add(20, 22) }\n"},"version":10}
